# ------------------------------------------------------------
# Gradle
# ------------------------------------------------------------

.gradle/
**/.gradle/

**/build/

# Keep Gradle wrapper
!gradle/wrapper/gradle-wrapper.jar


# ------------------------------------------------------------
# Kotlin
# ------------------------------------------------------------

.kotlin/
**/.kotlin/

*.kotlin_module


# ------------------------------------------------------------
# Kotlin/JS & Kotlin/Wasm
# ------------------------------------------------------------

node_modules/
**/node_modules/

.kotlin-js-store/
**/.kotlin-js-store/

# Keep dependency lock files for reproducible builds
kotlin-js-store/*
!kotlin-js-store/yarn.lock
!kotlin-js-store/wasm/
kotlin-js-store/wasm/*
!kotlin-js-store/wasm/yarn.lock

# Yarn / npm generated files
.yarn/
.yarn-cache/
.yarn-integrity
.pnp.*

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ------------------------------------------------------------
# IntelliJ IDEA / Android Studio
# ------------------------------------------------------------

.idea/
**/.idea/

*.iml
*.ipr
*.iws

out/
**/out/


# ------------------------------------------------------------
# Local machine configuration
# ------------------------------------------------------------

local.properties

.env
.env.*
!.env.example


